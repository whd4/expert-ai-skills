  "outcomes": {
    "a_adopt": "(1 - min(a_ramp, 24) / 48) * (a_ramp <= 24) + (24 / (2 * a_ramp)) * (a_ramp > 24)",
    "a_hours_net": "25 * 92.0 * a_adopt * a_util * max(a_hours - a_rework, 0)",
    "a_cost": "25 * 24 * (a_seat + a_overage) + a_setup",
    "a_value": "a_hours_net * wage * value_capture",
    "net_a": "a_value - a_cost",
    "b_adopt": "(1 - min(b_ramp, 24) / 48) * (b_ramp <= 24) + (24 / (2 * b_ramp)) * (b_ramp > 24)",
    "b_active": "25 * 92.0 * b_adopt * b_util",
    "b_usage": "b_adopt * b_util",
    "b_err_avg": "min(b_error * (1 - b_reliab * 1.0 / 2), 1)",
    "b_gross_hours": "b_active * b_hours",
    "b_tasks_total": "b_gross_hours / b_task_hours",
    "b_bad_actions": "b_tasks_total * b_err_avg",
    "b_escaped": "b_bad_actions * b_escape",
    "b_hours_net": "b_gross_hours * (1 - b_err_avg) - b_gross_hours * b_review - (b_bad_actions - b_escaped) * b_fix_hours",
    "b_incident_n": "b_incidents * 1.0 * (25 / 25) * (b_usage / 0.5) * (b_error / 0.05)",
    "b_cost": "25 * 24 * b_seat + 25 * 24 * b_usage * b_overage + b_setup + b_escaped * b_bad_cost + b_incident_n * b_incident_cost",
    "b_value": "b_hours_net * wage * value_capture",
    "net_b": "b_value - b_cost",
    "diff_b_minus_a": "net_b - net_a",
    "b_beats_a": "diff_b_minus_a > 0",
    "a_positive": "net_a > 0",
    "b_positive": "net_b > 0"
  }
